<Window x:Class="MultiRobloxManager.Dialogs.AccountManagerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Accounts"
        Width="640" Height="500"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource WindowBgBrush}"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True">
    <DockPanel Margin="14">
        <TextBlock DockPanel.Dock="Top" Text="Manage Roblox accounts"
                   Style="{StaticResource TitleText}" Margin="0,0,0,10" />

        <TextBlock DockPanel.Dock="Bottom" x:Name="StatusText"
                   Style="{StaticResource MutedLabel}"
                   TextWrapping="Wrap" Margin="0,8,0,0"
                   Text="Proxy URL is applied to Roblox auth calls only. SOCKS5 supported natively in .NET — http(s)://, socks5://, socks5h://, socks4://." />

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
            <Button x:Name="AddBtn" Content="Add / Update" Style="{StaticResource PrimaryButton}"
                    Click="OnAdd" Width="120" Margin="0,0,6,0" />
            <Button Content="Update Proxy" Click="OnUpdateProxy" Margin="0,0,6,0" />
            <Button Content="Remove Selected" Click="OnRemove" />
            <StackPanel HorizontalAlignment="Right" />
        </StackPanel>

        <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Margin="0,8,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Nickname"
                           VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBox   Grid.Row="0" Grid.Column="1" x:Name="NicknameEdit" Margin="0,0,12,0" />
                <TextBlock Grid.Row="0" Grid.Column="2" Text="Proxy URL"
                           VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBox   Grid.Row="0" Grid.Column="3" x:Name="ProxyEdit" />

                <TextBlock Grid.Row="1" Grid.Column="0" Text=".ROBLOSECURITY"
                           VerticalAlignment="Top" Margin="0,10,8,0" />
                <TextBox   Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" x:Name="CookieEdit"
                           AcceptsReturn="True" TextWrapping="Wrap" Height="80"
                           VerticalScrollBarVisibility="Auto" Margin="0,10,0,0" />
            </Grid>
        </Border>

        <DataGrid x:Name="AccountsGrid" SelectionMode="Single"
                  SelectionChanged="OnSelectRow">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Nickname" Binding="{Binding Nickname}" Width="140" />
                <DataGridTextColumn Header="Username" Binding="{Binding Username}" Width="160" />
                <DataGridTextColumn Header="User ID"  Binding="{Binding UserId}"   Width="100" />
                <DataGridTextColumn Header="Proxy"    Binding="{Binding Proxy}"    Width="*" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
