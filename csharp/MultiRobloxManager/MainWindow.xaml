<Window x:Class="MultiRobloxManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Multi Roblox Manager"
        Width="1120" Height="720"
        MinWidth="940" MinHeight="560"
        Background="{StaticResource WindowBgBrush}"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True">

    <DockPanel>

        <!-- Menu bar -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="Open Logs Folder" Click="OnOpenLogs" />
                <Separator />
                <MenuItem Header="Quit" InputGestureText="Ctrl+Q" Click="OnQuit" />
            </MenuItem>
            <MenuItem Header="_Accounts">
                <MenuItem Header="Manage Accounts…" Click="OnManageAccounts" />
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="About" Click="OnAbout" />
            </MenuItem>
        </Menu>

        <!-- Status bar -->
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="Ready" />
            </StatusBarItem>
        </StatusBar>

        <!-- Body -->
        <Grid Margin="14,10,14,4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
                <TextBlock Text="Multi Roblox Manager" Style="{StaticResource TitleText}" />
                <TextBlock x:Name="MetaLabel" Text="Roblox unknown" Style="{StaticResource MutedLabel}"
                           VerticalAlignment="Center" Margin="12,0,0,0" />
            </StackPanel>

            <!-- Launch card -->
            <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Game" VerticalAlignment="Center"
                               Margin="0,0,8,4" />
                    <TextBox  Grid.Row="0" Grid.Column="1" x:Name="PlaceEdit"
                              ToolTip="placeId (e.g. 920587237) or a roblox.com /games/&lt;id&gt;/… URL"
                              KeyDown="OnPlaceKeyDown" Margin="0,0,12,4" />

                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Account" VerticalAlignment="Center"
                               Margin="0,0,8,4" />
                    <ComboBox  Grid.Row="0" Grid.Column="3" x:Name="AccountCombo" Margin="0,0,0,4" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Label" VerticalAlignment="Center"
                               Margin="0,0,8,0" />
                    <TextBox   Grid.Row="1" Grid.Column="1" x:Name="LabelEdit"
                               KeyDown="OnPlaceKeyDown" Margin="0,0,12,0" />

                    <StackPanel Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2"
                                Orientation="Horizontal">
                        <Button x:Name="LaunchBtn" Content="Launch"
                                Style="{StaticResource PrimaryButton}"
                                Width="100" Click="OnLaunch" />
                        <Button Content="Save Preset" Margin="6,0,0,0"
                                Click="OnSavePreset" />
                    </StackPanel>

                    <StackPanel Grid.Row="2" Grid.ColumnSpan="4" Orientation="Horizontal"
                                Margin="0,8,0,0">
                        <TextBlock Text="Launch via:" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <RadioButton x:Name="ProtocolRadio" Content="Roblox launcher (recommended)"
                                     GroupName="Mode" IsChecked="True"
                                     Margin="0,0,14,0" Checked="OnModeChanged" />
                        <RadioButton x:Name="DirectRadio" Content="Direct (skip launcher)"
                                     GroupName="Mode" Checked="OnModeChanged" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Body splitter -->
            <Grid Grid.Row="2" Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="6" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>

                <!-- Running instances -->
                <Border Grid.Column="0" Style="{StaticResource Card}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Running instances"
                                   FontWeight="SemiBold" Margin="0,0,0,8" />
                        <TextBlock DockPanel.Dock="Bottom"
                                   Text="Ctrl/Shift-click for multi-select • Hop / Close act on the selection"
                                   Style="{StaticResource MutedLabel}" Margin="0,6,0,0" />
                        <DataGrid x:Name="InstancesGrid" SelectionMode="Extended"
                                  HeadersVisibility="Column">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Label"   Binding="{Binding Label}"            Width="120" />
                                <DataGridTextColumn Header="Account" Binding="{Binding AccountLabel}"     Width="140" />
                                <DataGridTextColumn Header="Place"   Binding="{Binding PlaceId}"          Width="90" />
                                <DataGridTextColumn Header="PID"     Binding="{Binding PidDisplay}"       Width="60" />
                                <DataGridTextColumn Header="Status"  Binding="{Binding StatusDisplay}"    Width="100" />
                                <DataGridTextColumn Header="CPU %"   Binding="{Binding CpuDisplay}"       Width="60" />
                                <DataGridTextColumn Header="RAM MB"  Binding="{Binding RamDisplay}"       Width="70" />
                                <DataGridTextColumn Header="Server (jobId)" Binding="{Binding JobIdDisplay}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>

                <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch"
                              Background="Transparent" ShowsPreview="True" />

                <!-- Presets -->
                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Saved presets"
                                   FontWeight="SemiBold" Margin="0,0,0,8" />
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="Launch"     Click="OnLaunchPreset"     Margin="0,0,4,0" />
                            <Button Content="Launch All" Click="OnLaunchAllPresets" Margin="0,0,4,0" />
                            <Button Content="Remove"     Click="OnRemovePreset" />
                        </StackPanel>
                        <DataGrid x:Name="PresetsGrid" SelectionMode="Single"
                                  MouseDoubleClick="OnPresetDoubleClick">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Label"   Binding="{Binding Label}"   Width="*" />
                                <DataGridTextColumn Header="Place"   Binding="{Binding PlaceId}" Width="90" />
                                <DataGridTextColumn Header="Account" Binding="{Binding AccountDisplay}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- Action bar -->
            <Border Grid.Row="3" Style="{StaticResource Card}" Padding="10,6">
                <StackPanel Orientation="Horizontal">
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="WINDOW" Style="{StaticResource GroupCaption}" />
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <Button Content="Focus" Width="80" Click="OnFocus" Margin="0,0,4,0" />
                            <Button Content="Cycle" Width="80" Click="OnCycle" />
                        </StackPanel>
                    </StackPanel>
                    <Rectangle Width="1" Fill="{StaticResource BorderBrush}" Margin="4,0,12,0" />
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="SERVER" Style="{StaticResource GroupCaption}" />
                        <Button Content="Hop" Width="100" Click="OnHop" Margin="0,2,0,0" />
                    </StackPanel>
                    <Rectangle Width="1" Fill="{StaticResource BorderBrush}" Margin="4,0,12,0" />
                    <StackPanel>
                        <TextBlock Text="INSTANCE" Style="{StaticResource GroupCaption}" />
                        <Button Content="Close" Width="80" Click="OnCloseInstance" Margin="0,2,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
